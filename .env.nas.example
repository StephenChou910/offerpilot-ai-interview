# 复制为 .env.nas 后填写真实值。该文件不会提交 Git。

# NAS 持久化数据目录（推荐使用空间充足的 vol2）
NAS_DATA_DIR=/vol2/offerpilot
NAS_WEB_BIND=0.0.0.0
NAS_WEB_PORT=18080

# 局域网验收地址；后续启用域名/Tunnel 后替换为 HTTPS 域名
CORS_ALLOWED_ORIGINS=http://192.168.5.8:18080

# PostgreSQL / Redis / MinIO / JWT：均应替换为高强度随机值
POSTGRES_DB=interview_guide
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_long_random_password
REDIS_PASSWORD=replace_with_a_different_long_random_password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_with_a_third_long_random_password
MINIO_BUCKET=interview-guide
JWT_SECRET_KEY=replace_with_a_random_string_at_least_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM 与 Embedding（根据你现有 API 账号填写；不要提交真实 Key）
AI_BAILIAN_API_KEY=
AI_MODEL=qwen-plus
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_EMBEDDING_PROVIDER=zhipu
AI_EMBEDDING_MODEL=embedding-3
AI_ZHIPU_API_KEY=
AI_EMBEDDING_API_KEY=
DASHSCOPE_API_KEY=

# 联网搜索不是局域网验收必需项；没有 Key 可留空并按实际配置关闭相关入口
TAVILY_API_KEY=
SEARCH_ENGINE=tavily
APP_INTERVIEW_FOLLOW_UP_COUNT=0
